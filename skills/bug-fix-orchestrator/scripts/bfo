#!/usr/bin/env bash
# Wrapper cho bfo_state.py: chọn Python >= 3.9 (venv skills nếu có, else python3) để lệnh gọi luôn là
# một đường dẫn duy nhất, không phụ thuộc cách shell tách từ hay hook chặn đường dẫn venv.
set -euo pipefail
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
for py in "$HOME/.claude/skills/.venv/bin/python3" python3; do
  if command -v "$py" >/dev/null 2>&1 && "$py" -c 'import sys; sys.exit(sys.version_info < (3, 9))' 2>/dev/null; then
    exec "$py" "$DIR/bfo_state.py" "$@"
  fi
done
echo "bfo: cần Python >= 3.9" >&2
exit 2
